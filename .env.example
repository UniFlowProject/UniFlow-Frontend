VITE_ENV=development

# Each service gets ONE complete base URL. The code only appends resource paths
# (/periods, /courses, /tasks, /notifications, ...); it never adds a prefix or version.
#
# Direct to the services (local dev, services run standalone):
#   VITE_ACADEMIC_SERVICE_URL=http://localhost:3001
#   VITE_NOTIFICATIONS_SERVICE_URL=http://localhost:3003
# Through the API Gateway (root docker-compose.dev.yml with Floci, or production), prefix and version included:
#   VITE_ACADEMIC_SERVICE_URL=http://uniflow.execute-api.localhost.floci.io:4566/api/academic/v2
#   VITE_NOTIFICATIONS_SERVICE_URL=http://uniflow.execute-api.localhost.floci.io:4566/api/notifications/v2
VITE_ACADEMIC_SERVICE_URL=
VITE_NOTIFICATIONS_SERVICE_URL=

# Optional (legacy Azure APIM). When unset, the Ocp-Apim-Subscription-Key header is not sent.
VITE_APIM_TOKEN=

# Optional (legacy Google OAuth provider). Leave unset to use Cognito only.
VITE_GOOGLE_CLIENT_ID=

# Optional. WebSocket URL for push notifications; a built-in default is used when unset.
VITE_NOTIFICATIONS_WEB_APP_URL=

VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
